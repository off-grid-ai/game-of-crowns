; Engine configuration file.
config_version=5

[application]

config/name="Game of Crowns"
config/description="A living medieval realm, simulated by Freeciv, watched and steered by you."
config/icon="res://assets/icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

AppServices="*res://scripts/app_services.gd"
Clock="*res://scripts/world_clock.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"

[rendering]

limits/cluster_builder/max_clustered_elements=4096

global_illumination/sdfgi/frames_to_update_lights=4
global_illumination/sdfgi/frames_to_converge=5
textures/vram_compression/import_etc2_astc=true
scaling_3d/mode=3
anti_aliasing/quality/screen_space_aa=1
scaling_3d/scale=0.67
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
mesh_lod/lod_change/threshold_pixels=16.0
occlusion_culling/use_occlusion_culling=true

[audio]

driver/enable_input=true

[shader_globals]

world_time={
"type": "float",
"value": 0.0
}
wind={
"type": "vec4",
"value": Vector4(0.8, 0, 0.6, 0.15)
}
wet={
"type": "float",
"value": 0.0
}
snow={
"type": "float",
"value": 0.0
}

[filesystem]

import/blender/enabled=false


[threading]

; Every task the game hands the worker pool is low-priority (merges, town packs, kept writes, navigation, roads), and
; some wait on others; at Godot's default 0.3 a 3-core Mac (GitHub's build runner) had one thread for them and the
; bake froze at Gildport for the 5-hour timeout (reproduced with worker_pool/max_threads=3). No task is high-priority, so
; the whole pool is theirs.
worker_pool/low_priority_thread_ratio=1.0
