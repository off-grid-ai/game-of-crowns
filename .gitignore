# Game of Crowns: what stays out of git.
# Rule of thumb: our code, docs, our own art and small config go in; generated
# state, caches and other people's art (fetched again per ASSETS in the README)
# stay out. Godot's .import files are kept even for excluded art: they carry
# our import settings (retargeting, compression) and are tiny.

# --- OS and editors ---
.DS_Store
*.swp
.vscode/
.idea/

# --- Godot ---
realm/.godot/
*.tmp
realm/export/

# --- Third-party art (Sketchfab, Mixamo, Quaternius, Poly Haven, Kenney) ---
# Binaries out, import settings and licence notes in.
realm/assets/realistic/**
realm/assets/people/**
realm/assets/hero/**
realm/assets/anims/**
realm/assets/props/**
realm/assets/nature/**
realm/assets/q/**
realm/assets/ground/**
realm/assets/village/**
realm/assets/interiors/**
realm/assets/audio/**
realm/assets/cavalry/**
realm/assets/weapons/**
realm/assets/crops/**
realm/assets/fx/**
realm/assets/armies/**
realm/assets/ai3d/**
realm/assets/meshy/**
!realm/assets/realistic/**/
!realm/assets/people/**/
!realm/assets/hero/**/
!realm/assets/anims/**/
!realm/assets/props/**/
!realm/assets/nature/**/
!realm/assets/q/**/
!realm/assets/ground/**/
!realm/assets/village/**/
!realm/assets/interiors/**/
!realm/assets/audio/**/
!realm/assets/cavalry/**/
!realm/assets/weapons/**/
!realm/assets/crops/**/
!realm/assets/fx/**/
!realm/assets/armies/**/
!realm/assets/ai3d/**/
!realm/assets/meshy/**/
!realm/assets/meshy/**/import.json
!realm/assets/armies/**/tracks.json
!realm/assets/**/*.import
!realm/assets/**/license.txt
!realm/assets/**/LICENSE*
!realm/assets/**/CREDITS*

# --- All art lives in R2 (Mac 2026-11-15: 'all the art needs to go to r2') ---
# Every model, texture, sound and concept image goes to the bucket game-of-crowns-assets with
# realm/tools/r2_sync.sh and comes back with realm/tools/r2_pull.sh; git keeps code, data, Godot's .import files
# and licences.
realm/assets/**/*.glb
realm/assets/**/*.gltf
realm/assets/**/*.bin
realm/assets/**/*.fbx
realm/assets/**/*.obj
realm/assets/**/*.blend
realm/assets/**/*.png
realm/assets/**/*.jpg
realm/assets/**/*.jpeg
realm/assets/**/*.webp
realm/assets/**/*.tga
realm/assets/**/*.exr
realm/assets/**/*.hdr
realm/assets/**/*.ktx
realm/assets/**/*.ktx2
realm/assets/**/*.dds
realm/assets/**/*.ogg
realm/assets/**/*.wav
realm/assets/**/*.mp3
realm/assets/**/*.flac
realm/assets/**/*.mp4
realm/assets/**/*.webm
realm/assets/**/*.svg
docs/art/**/*.glb
docs/art/**/*.gltf
docs/art/**/*.bin
docs/art/**/*.fbx
docs/art/**/*.obj
docs/art/**/*.blend
docs/art/**/*.png
docs/art/**/*.jpg
docs/art/**/*.jpeg
docs/art/**/*.webp
docs/art/**/*.tga
docs/art/**/*.exr
docs/art/**/*.hdr
docs/art/**/*.ktx
docs/art/**/*.ktx2
docs/art/**/*.dds
docs/art/**/*.ogg
docs/art/**/*.wav
docs/art/**/*.mp3
docs/art/**/*.flac
docs/art/**/*.mp4
docs/art/**/*.webm
docs/art/**/*.svg

# Raw downloads waiting to be sorted into the game.
/downloads/
/assets/

# --- The bridge's running state ---
node_modules/
bridge/chronicles/
bridge/stories/
bridge/archive/
bridge/saves/
bridge/state/
bridge/*.sav.zst
bridge/*.log
bridge/records.json
bridge/scenarios.json
bridge/resume.serv
bridge/probe.*
# Azgaar's raw exports: inputs to tools/azgaar_*.py, regenerated from the Azgaar map.
bridge/data/Belia *

# The baseline realm (a few years of history new chronicles start from) is kept,
# saves and all.
!bridge/baseline/**

# --- Screenshots and scratch ---
shots/
*.png.tmp

# --- Local tool config (the project's skills are shared) ---
.claude/*
!.claude/skills/
build/

# Your own names for houses and people (the Lore's Rename): yours, never pushed
bridge/names.json
bridge/written.json

# Python caches from tools
__pycache__/

# Baked meshes and towns (tools/bake.gd), made from third-party art before each export
realm/baked/
# The houses spoken words: our own recordings (OGAD Kokoro), kept in git.
!realm/assets/audio/voice/houses/*.ogg
!realm/assets/audio/voice/houses/README.md
