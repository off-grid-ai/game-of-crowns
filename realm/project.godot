; Engine configuration file.
config_version=5

[application]

config/name="Game of Crowns"
config/description="A living medieval realm, simulated by Freeciv, watched and steered by you."
config/icon="res://assets/icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

AppServices="*res://scripts/app_services.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[physics]

common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"

[rendering]

limits/cluster_builder/max_clustered_elements=4096

global_illumination/sdfgi/frames_to_update_lights=4
global_illumination/sdfgi/frames_to_converge=5
textures/vram_compression/import_etc2_astc=true
scaling_3d/mode=4
scaling_3d/scale=0.67
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
mesh_lod/lod_change/threshold_pixels=4.0

[audio]

driver/enable_input=true

[shader_globals]

wind={
"type": "vec4",
"value": Vector4(0.8, 0, 0.6, 0.15)
}
wet={
"type": "float",
"value": 0.0
}
